    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>328f8de4-2654-4b79-8fd5-178f92882b2a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.13.0" />
